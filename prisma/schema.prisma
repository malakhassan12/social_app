
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ============================================================
// USER
// ============================================================

model User {
  id        String   @id @default(cuid())
  phone     String?

  emails    UserEmail[]

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}


// ============================================================
// USER EMAIL
// ============================================================


model UserEmail {
  id       String @id @default(cuid())

  email    String @unique

  userId   String
  user     User   @relation(fields: [userId],references: [id],onDelete: Cascade)

  password String

  accounts Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ACCOUNT
// ============================================================

enum AccountType {
  PRIVATE
  PUBLIC
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
}

model Account {
  id String @id @default(cuid())

  // Owner
  emailId String
  email UserEmail @relation(fields: [emailId],references: [id], onDelete: Cascade)

  sessions Session[]

  // Profile
  username String @unique
  name     String
  bio      String?
  image    String?
  website  String?
  country  String

  status AccountStatus @default(ACTIVE)


  // Privacy
  type AccountType @default(PUBLIC)

  isOpenMessages Boolean @default(true) 

  isOpenGroup Boolean @default(true) 

  isOpenComments  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================================================
  // SOCIAL RELATIONS
  // ==========================================================

  // Content
  posts    Post[]
  comments Comment[]

  // Following
  //
  // followers = accounts following THIS account
  // following = accounts THIS account follows
  //
  followers Follower[] @relation("FollowingAccount")
  following Follower[] @relation("FollowerAccount")

  // Follow requests
  followRequestsSent     FollowRequest[] @relation("FollowRequestsSent")
  followRequestsReceived FollowRequest[] @relation("FollowRequestsReceived")

  // Likes
  postLikes    PostLike[]
  commentLikes CommentLike[]

  // Shares
  sharesFrom Share[] @relation("ShareFrom")
  sharesTo   Share[] @relation("ShareTo")

  // Notifications
  receivedNotifications Notification[] @relation("NotificationReceiver")
  createdNotifications  Notification[] @relation("NotificationCreator")

  // Messaging
  conversationParticipants ConversationParticipant[]
  messages                 Message[]

  messageReaction MessageReaction[]

  // Message reads
  messageReads MessageRead[]

  @@index([emailId])
  @@index([username])
  @@index([id, createdAt])
}


// ============================================================
// FOLLOWER
// ============================================================
  // Malak follows Ahmed
  // followerId     followingId
  // Malak          Ahmed

model Follower {
  id String @id @default(cuid())

  followerId  String
  followingId String

  follower Account @relation( "FollowerAccount", fields: [followerId], references: [id], onDelete: Cascade)

  following Account @relation( "FollowingAccount",fields: [followingId], references: [id], onDelete: Cascade )

  createdAt DateTime @default(now())

  // An account cannot follow another account twice.
  @@unique([followerId, followingId])

  @@index([followerId])
  @@index([followingId])
}


// ============================================================
// FOLLOW REQUEST = Connection = friend Ship
// ============================================================

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model FollowRequest {
  id String @id @default(cuid())

  requesterId String
  receiverId  String

  requester Account @relation("FollowRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)

  receiver Account @relation("FollowRequestsReceived",fields: [receiverId],references: [id],onDelete: Cascade )

  status FollowRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Only one active relationship/request between
  // the same two accounts.
  @@unique([requesterId, receiverId])

  @@index([receiverId, status])
  @@index([requesterId, status])
}


// ============================================================
// POST
// ============================================================

model Post {
  id String @id @default(cuid())

  desc String @db.Text

  image String[]
  video String[]

  // If your product supports private posts independently
  // from a private account.
  isPrivate Boolean @default(false)


  isRemoved Boolean @default(false)


  isOpenComments Boolean @default(true)

  accountId String

  author Account @relation( fields: [accountId],references: [id],onDelete: Cascade)

  likes         PostLike[]
  comments      Comment[]
  notifications Notification[]
  shares        Share[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([createdAt])
  @@index([accountId, createdAt])

}


// ============================================================
// POST LIKE
// ============================================================

model PostLike {
  id String @id @default(cuid())

  accountId String
  postId    String

  account Account @relation(fields: [accountId],  references: [id],  onDelete: Cascade)

  post Post @relation(fields: [postId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  // One account can like a post only once.
  @@unique([accountId, postId])

  @@index([postId])
  @@index([accountId])
}


// ============================================================
// COMMENT
// ============================================================

model Comment {
  id String @id @default(cuid())

  content String @db.Text

  isRemoved Boolean @default(false)

  removedAt DateTime?


  accountId String
  postId    String

  author Account @relation( fields: [accountId], references: [id], onDelete: Cascade)

  post Post @relation(fields: [postId],references: [id],onDelete: Cascade)

  likes CommentLike[]

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([accountId])
  @@index([postId, createdAt])
}


// ============================================================
// COMMENT LIKE
// ============================================================

model CommentLike {
  id String @id @default(cuid())

  accountId String
  commentId String

  account Account @relation(fields: [accountId],references: [id],onDelete: Cascade)

  comment Comment @relation(fields: [commentId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  // One account can like a comment only once.
  @@unique([accountId, commentId])

  @@index([commentId])
  @@index([accountId])
}


// ============================================================
// SHARE
// ============================================================

model Share {
  id String @id @default(cuid())

  shareFromId String
  shareToId   String
  postId      String

  isOpen Boolean @default(false) 


  shareFrom Account @relation("ShareFrom",fields: [shareFromId],references: [id],onDelete: Cascade)

  shareTo Account @relation("ShareTo",fields: [shareToId],references: [id],onDelete: Cascade)

  post Post @relation( fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([shareFromId])
  @@index([shareToId])
  @@index([postId])
}


// ============================================================
// NOTIFICATION
// ============================================================

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  PUBLISHED
  SHARE
  FRIEND
}

model Notification {
  id String @id @default(cuid())

  title   String
  content String

  notificationType NotificationType

  receiverId String
  creatorId  String

  postId String?

  read Boolean @default(false)

  receiver Account @relation("NotificationReceiver",fields: [receiverId],references: [id],onDelete: Cascade)

  creator Account @relation("NotificationCreator",fields: [creatorId],references: [id],onDelete: Cascade)

  post Post? @relation(fields: [postId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())


  @@index([receiverId, createdAt])

  @@index([receiverId, read, createdAt])
  @@index([creatorId])
  @@index([postId])
}


// ============================================================
// CONVERSATION
// ============================================================

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id String @id @default(cuid())

  name String? 

  ownerId String?

  image String?
  
  type ConversationType @default(DIRECT)

  isOpen  Boolean @default(true) //  By admin only can make that 

  isRemoved Boolean @default(false)

  removedAt DateTime?

  isOpenAddition  Boolean @default(true) //  By admin only can make that and in type Group

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ============================================================
// CONVERSATION PARTICIPANT
// ============================================================

enum ConversationParticipantType {
  REMOVED
  EXIST
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  accountId      String

  conversation Conversation @relation(fields: [conversationId],references: [id],onDelete: Cascade)

  account Account @relation(fields: [accountId],references: [id],onDelete: Cascade)

  joinedAt DateTime @default(now())

  isAdmin Boolean @default(false)

  type ConversationParticipantType @default(EXIST)

  // The same account cannot join the same conversation twice.
  @@unique([conversationId, accountId])

  @@index([accountId])
}


// ============================================================
// MESSAGE
// ============================================================

model Message {
  id String @id @default(cuid())

  content String @db.Text

  image String?

  senderId       String
  conversationId String

  // Reply
  replyToMessageId String?
  replyToMessage   Message? @relation("MessageReplies",fields: [replyToMessageId],references: [id],onDelete: SetNull)

  replies Message[] @relation("MessageReplies")

  sender Account @relation(fields: [senderId],references: [id],onDelete: Cascade)

  conversation Conversation @relation(fields: [conversationId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageReads MessageRead[]
  messageReactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToMessageId])
}

enum MessageReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
  CELEBRATE
}

model MessageReaction {
  id String @id @default(cuid())

  accountId String
  messageId String

  isLiked Boolean @default(false)

  type MessageReactionType

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade )

  message Message @relation(fields: [messageId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  // One reaction of one type per account per message
  @@unique([accountId, messageId])
  
  @@index([messageId])
  @@index([accountId])
}


// ============================================================
// MESSAGE READ
// ============================================================

model MessageRead {
  id String @id @default(cuid())

  messageId String
  accountId String

  message Message @relation(fields: [messageId],references: [id],onDelete: Cascade)

  account Account @relation(fields: [accountId],references: [id],onDelete: Cascade)

  readAt DateTime @default(now())

  // An account can mark a specific message as read once.
  @@unique([messageId, accountId])

  @@index([accountId])
}


// ============================================================
// SESSION
// ============================================================

model Session {
  id String @id @default(cuid())

  userId String
  accountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt DateTime

  revokedAt DateTime?

  @@index([userId])
  @@index([accountId])
  @@index([expiresAt])
}